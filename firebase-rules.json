{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$roomId": {
        ".read": "auth != null",
        ".write": "auth != null"
      }
    },
    "packs": {
      "$packId": {
        ".read": true,
        ".write": "auth != null && auth.uid == 'HFjjKgS6l6ZMWHhYLApzPkl2qbi2'"
      }
    },
    "orders": {
      ".read": "auth != null && auth.uid == 'HFjjKgS6l6ZMWHhYLApzPkl2qbi2'",
      "$orderId": {
        ".write": "auth != null && auth.uid == 'HFjjKgS6l6ZMWHhYLApzPkl2qbi2'"
      }
    },
    "settings": {
      ".read": "auth != null && auth.uid == 'HFjjKgS6l6ZMWHhYLApzPkl2qbi2'",
      ".write": "auth != null && auth.uid == 'HFjjKgS6l6ZMWHhYLApzPkl2qbi2'"
    },
    "voices": {
      ".read": "auth != null && auth.uid == 'HFjjKgS6l6ZMWHhYLApzPkl2qbi2'",
      "$formId": {
        ".write": "auth != null && auth.uid == 'HFjjKgS6l6ZMWHhYLApzPkl2qbi2'",
        "$voiceId": {
          ".write": "auth != null && ((!data.exists() && root.child('forms/' + $formId + '/meta').exists()) || (!newData.exists() && root.child('forms/' + $formId + '/vlist/' + $voiceId + '/uid').val() == auth.uid))",
          ".validate": "newData.hasChildren(['data', 'mime'])",
          "data": { ".validate": "newData.isString() && newData.val().length <= 3000000" },
          "mime": { ".validate": "newData.isString() && newData.val().length <= 60" },
          "$other": { ".validate": false }
        }
      }
    },
    "forms": {
      ".read": "auth != null && auth.uid == 'HFjjKgS6l6ZMWHhYLApzPkl2qbi2'",
      "$formId": {
        ".write": "auth != null && auth.uid == 'HFjjKgS6l6ZMWHhYLApzPkl2qbi2'",
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && $formId.matches(/^[a-z0-9]{12}$/) && (!data.exists() || data.child('uid').val() == auth.uid)",
          ".validate": "newData.hasChildren(['occasion', 'hero', 'players', 'uid', 'createdAt'])",
          "occasion": { ".validate": "newData.isString() && newData.val().length <= 20" },
          "hero": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 80" },
          "players": { ".validate": "newData.isNumber() && newData.val() >= 2 && newData.val() <= 11" },
          "rounds": { ".validate": "newData.isNumber() && newData.val() >= 1 && newData.val() <= 3" },
          "gameDate": { ".validate": "newData.isString() && newData.val().matches(/^\\d{4}-\\d{2}-\\d{2}$/)" },
          "avito": { ".validate": "newData.isString() && newData.val().length <= 80" },
          "uid": { ".validate": "newData.val() == auth.uid" },
          "createdAt": { ".validate": "newData.val() == now || newData.val() == data.val()" },
          "$other": { ".validate": false }
        },
        "buyer": {
          ".read": "auth != null && root.child('forms/' + $formId + '/meta/uid').val() == auth.uid",
          ".write": "auth != null && root.child('forms/' + $formId + '/meta/uid').val() == auth.uid",
          "updatedAt": { ".validate": "newData.val() == now" },
          "$field": { ".validate": "$field.matches(/^[a-z0-9]{1,12}$/) && newData.isString() && newData.val().length <= 2500" }
        },
        "vlist": {
          ".read": "auth != null && root.child('forms/' + $formId + '/meta/uid').val() == auth.uid",
          "$voiceId": {
            ".write": "auth != null && ((!data.exists() && root.child('forms/' + $formId + '/meta').exists()) || (!newData.exists() && data.child('uid').val() == auth.uid))",
            ".validate": "newData.hasChildren(['by', 'sec', 'createdAt'])",
            "field": { ".validate": "newData.isString() && newData.val().length <= 12" },
            "uid": { ".validate": "newData.val() == auth.uid" },
            "by": { ".validate": "newData.val() == 'buyer' || newData.val() == 'guest'" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 80" },
            "sec": { ".validate": "newData.isNumber() && newData.val() >= 0 && newData.val() <= 600" },
            "createdAt": { ".validate": "newData.val() == now" },
            "$other": { ".validate": false }
          }
        },
        "guests": {
          "$guestId": {
            ".write": "auth != null && !data.exists() && root.child('forms/' + $formId + '/meta').exists()",
            ".validate": "newData.hasChildren(['createdAt'])",
            "createdAt": { ".validate": "newData.val() == now" },
            "$field": { ".validate": "$field.matches(/^[a-z0-9]{1,12}$/) && newData.isString() && newData.val().length <= 2500" }
          }
        }
      }
    }
  }
}
